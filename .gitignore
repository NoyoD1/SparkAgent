# =============================================================================
# Pi Agent — .gitignore
# =============================================================================

# ---- 依赖 ----
node_modules/
.pnpm-store/
*/node_modules/

# ---- 真实 API key (重要: 不进 git) ----
.env
.env.local
.env.*.local
!*.env.example
!**/.env.example

# ---- server log (可能有 key 痕迹) ----
.server.log
.server.log.err
*.log
!*.log.example

# ---- 临时截图 + 测试产物 ----
.screenshots/*.png
.screenshots/*.log
.screenshots/*.out.log
.screenshots/.test-*.cjs
.screenshots/test-*.cjs
.screenshots/snap-*.cjs.bak
# 通用备份: .bak-v2 / .bak-v3 等
*.bak-*
# commit message 临时文件
.commit-msg.tmp
# PowerShell 5.1 pipe 编码 fixture 临时文件
test-stdin-*.jsonl

# ---- build 产物 ----
dist/
build/
out/
*.tsbuildinfo
.DS_Store

# ---- 编辑器/系统 ----
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
.DS_Store
$RECYCLE.BIN/
desktop.ini
*.lnk

# ---- Tauri (Phase 3) ----
# Tauri 2 build artifacts — keep source committed
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
*.app
*.dmg
# Default ignore executable bundles / installer artifacts
*.exe
*.msi
*.deb
*.AppImage
# v0.5.8: src-tauri/binaries/pi-agent-sidecar-<target-triple>.exe 是 bun compile
#   产物的 Tauri 命名约定拷贝, 必须 commit (Tauri 2 sidecar 机制要求这个名字,
#   干净 Windows 机器 install MSI/NSIS 时 installer 会自动从 binaries/ 部署
#   到 install_dir 跟 pi-agent-desktop.exe 配对, 详见 D172). 放在 *.exe 之后
#   才能 override 默认 ignore.
!src-tauri/binaries/pi-agent-sidecar-*.exe
# sidecar/dist/pi-agent-sidecar.exe 是 bun build --compile 产物, 必须 commit (D163
#   跨项目规则: Tauri release 不依赖 system Node, 必须 ship standalone .exe). 例外:
!sidecar/dist/pi-agent-sidecar.exe

# ---- 其他仓库 / 临时目录 ----
# pi/ 是另一份 git 仓库的 clone (不同的项目, 不要混)
pi/
# pi-sdk/ 是 earendil-works/pi 仓库的 clone (v0.4+ 集成 pi-ai + pi-agent-core 的来源)
# 用 file: 引用, 不进 git
pi-sdk/
# 临时 inspect SDK 用的废纸篓
tmp-inspect-pi-sdk/
*.bak-*

# ---- sidecar 烟测日志 + 临时测试脚本 ----
sidecar/smoke-*.log
# 临时测试/调试脚本 (test-smoke-*.mjs / test-format.mjs / test-401.mjs 等),
# 跑完确认 PASS 就删, 不入 git
sidecar/test-*.mjs
sidecar/debug-*.jsonl
sidecar/smoke-test.jsonl

.tauri-*.log
.tauri-*.log.bak
