{
  "name": "pi-agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi Agent server — Node.js 22 + Hono + WebSocket, wraps @earendil-works/pi-coding-agent SDK. Phase 2 纯 SDK demo.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
