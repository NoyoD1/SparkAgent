# =============================================================================
# Pi Agent Server — API Keys (v0.2: 走服务端, 不走前端 localStorage / 协议)
# =============================================================================
#
# 用法:
#   1. cp .env.example .env
#   2. 把你有的 provider key 填到对应行, 删 # 注释
#   3. 没用到的 provider 整行留空 / 留 # 注释
#   4. 重启 server (tsx watch 自动 reload)
#
# 内置 provider 命名约定: <PROVIDER>_API_KEY (PROVIDER 大写)
#   - anthropic    → ANTHROPIC_API_KEY
#   - openai       → OPENAI_API_KEY
#   - deepseek     → DEEPSEEK_API_KEY
#   - moonshotai   → MOONSHOTAI_API_KEY
#   - google       → GOOGLE_API_KEY
#   - groq         → GROQ_API_KEY
#   - MiniMax       → MINIMAX_API_KEY
#
# 留空 = 该 provider 在 UI 里 "key 未配置", 选 model 时会拿到 fallback list
# 但 LLM 调用会 fail (config_error: "No API key for provider ...")
#
# =============================================================================
# v0.2+: openai-compatible (第三方代理) 走自定义 env 名
#   在 client UI 加 provider 时填 "API Key ENV 变量名" (默认 OPENAI_COMPATIBLE_KEY)
#   server 会从 process.env[你填的 env 名] 读 key
#   多个第三方可并存, 每个用不同 env 名 (例: SHANGTANG_KEY / OPENROUTER_KEY)
# =============================================================================

# Anthropic (Claude 系列) — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT 系列) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# DeepSeek — https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-...

# Moonshot Kimi — https://platform.moonshot.cn/console/api-keys
# MOONSHOTAI_API_KEY=sk-...

# Google Gemini — https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIza...

# Groq — https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# MiniMax — (走 token.sensenova.cn 代理) — 找代理给的 key
# MINIMAX_API_KEY=eyJ...

# =============================================================================
# 第三方 (openai-compatible) — 任意 env 名, 在 client UI 加 provider 时指定
# =============================================================================

# ----- 商汤 (SenseTime) — https://platform.sensenova.cn -----
# client UI 选 "OpenAI 兼容 (自定义 baseUrl)" 类型
# client UI Base URL = https://token.sensenova.cn/v1
# client UI API Key ENV 字段 = SHANGTANG_KEY
# 下面这行 = 后台填你的商汤 key (找商汤代理给的 token, 一般 sk- 开头)
SHANGTANG_KEY=

# ----- 默认 (client UI 不填 env 字段就用这个) -----
OPENAI_COMPATIBLE_KEY=

# ----- 例子: OpenRouter — baseUrl=https://openrouter.ai/api/v1 -----
# client UI Base URL = https://openrouter.ai/api/v1
# client UI API Key ENV 字段 = OPENROUTER_KEY
OPENROUTER_KEY=

# ----- 任意自建代理 -----
# MYPROXY_KEY=

# =============================================================================
# 🚀 商汤 provider 完整添加流程 (示例):
# =============================================================================
# 1. 把上面 SHANGTANG_KEY= 后面填上你的 key, 整行变:
#      SHANGTANG_KEY=sk-xxxxx你的真key
#
# 2. 重启 server (或者等 tsx watch 自动 reload, 我帮你重启)
#
# 3. 浏览器打开 http://localhost:5174/
#
# 4. 进 Settings → Providers → 点 "+ 添加供应商"
#
# 5. 弹出的 form 里:
#      - 类型: 选 "OpenAI 兼容 (自定义 baseUrl)"
#      - 名称: 随便填, 比如 "商汤159"
#      - Base URL: https://token.sensenova.cn/v1
#      - API Key ENV: SHANGTANG_KEY
#      - 点 "创建 + 拉取模型"  → server 拿 SHANGTANG_KEY 去拉模型
#
# 6. 加完在 list 里点 "商汤159" → 在右侧选个 model (deepseek-v4-flash / glm-5.2)
#    → 点 "设为当前"  → 回到 chat 就能用它发消息
# =============================================================================


