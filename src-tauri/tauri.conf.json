{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Agent",
  "version": "0.1.0",
  "identifier": "com.piagent.desktop",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "node ../scripts/dev-fe.mjs",
    "beforeBuildCommand": "node ../scripts/build-fe.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Pi Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pi-agent-sidecar"
    ]
  }
}
